<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.mockserver.mapper.MockUserMapper">

    <select id="findByScenarioKey" resultType="com.financial.mockserver.domain.MockUser">
        SELECT
            id,
            scenario_key AS scenarioKey,
            nickname,
            email,
            is_active AS isActive
        FROM mock_user
        WHERE scenario_key = #{scenarioKey}
          AND is_active = 1
    </select>

</mapper>
